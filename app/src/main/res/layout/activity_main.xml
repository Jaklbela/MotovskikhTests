<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.MainActivity">

    <com.example.motovskikh_tests.BackgroundPainter
        android:id="@+id/backgroundPainter"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </com.example.motovskikh_tests.BackgroundPainter>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/semi_transparent_black">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="wrap_content"
            android:layout_height="71dp"
            app:layout_constraintBottom_toTopOf="@+id/testsTheme"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/avatar_horizontal"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/testsTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tests_theme"
            android:textAppearance="@style/HeadingTextStyle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar" />

        <ListView
            android:id="@+id/testLists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:entries="@array/tests"
            app:layout_constraintTop_toBottomOf="@id/testsTheme"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>